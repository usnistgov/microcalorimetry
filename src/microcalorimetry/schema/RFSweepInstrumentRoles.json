{
    "definitions": {
        "RFSweepMeasurementMode": {
            "description": "describes what settings to use on an instrument for a particular mode of the experiment.",
            "allOf": [
                {
                    "$ref": "InstrumentSettings.json#/definitions/AnyInstrument"
                },
                {
                    "type": "object",
                    "properties": {
                        "enable": {
                            "type": "boolean",
                            "description": "enables the instrument for a particular mode of the experiment."
                        }
                    }
                }
            ]
        },
        "RFSweepInstrumentRole": {
            "type": "object",
            "properties": {
                "output_column": {
                    "type": "string",
                    "description": "Name of the output column to save to the data record."
                },
                "model": {
                    "type": "string",
                    "description": "Manufacturer model code of instrument. See possible instruments."
                },
                "serial": {
                    "type": "string",
                    "description": "Property tag or serial used to ID instruments."
                },
                "*IDN?": {
                    "type": "string",
                    "description": "Response to a *IDN? query or equivalent."
                },
                "GPIB_address": {
                    "type": "string",
                    "description": "Address of the GPIB Resouce"
                },
                "role": {
                    "type": "string",
                    "description": "Designates the behaviour of the instrument during the measurement.",
                    "enum": [
                        "thermopile_monitor",
                        "bias_monitor",
                        "RF_source",
                        "RF_amplitude_adjuster",
                        "power_meter"
                    ]
                },
                "initial_settings": {
                    "type": "object",
                    "description": "Describes the initial state of the instrument.",
                    "$ref": "InstrumentSettings.json#/definitions/AnyInstrument"
                },
                "monitor_mode_settings": {
                    "$ref": "#/definitions/RFSweepMeasurementMode",
                    "description": "Describes how the instrument should behave during the monitor mode of the experiment."
                },
                "fast_off_mode_settings": {
                    "$ref": "#/definitions/RFSweepMeasurementMode",
                    "description": "Describes how the instrument should behave during the monitor mode of the experiment."
                }
            },
            "required": [
                "model",
                "GPIB_address",
                "role",
                "initial_settings",
                "serial"
            ],
            "additionalProperties": false
        }
    }
}