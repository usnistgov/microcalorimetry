{
    "definitions": {
        "AnyInstrument": {
            "description": "Describes the settings used for an arbitrary instrument",
            "anyOf": [
                {
                    "$ref": "#/definitions/Voltmeter"
                },
                {
                    "$ref": "#/definitions/RF Source"
                },
                {
                    "$ref": "#/definitions/Voltage Source"
                },
                {
                    "$ref": "#/definitions/Commercial Power Meter"
                },
                {
                    "$ref": "#/definitions/SMU"
                }
            ]
        },
        "Voltmeter": {
            "description": "Possible  voltmeter settings.",
            "type": "object",
            "properties": {
                "v_range": {
                    "anyof": [
                        {
                            "type": "str",
                            "enum": [
                                "auto"
                            ]
                        },
                        {
                            "type": "number",
                            "minimum": 0
                        }
                    ]
                },
                "nplc": {
                    "type": "number",
                    "description": "Number of power line cycles "
                },
                "num_readings": {
                    "type": "integer",
                    "description": "Number of readings to take for each poll"
                },
                "timer": {
                    "type": "number",
                    "description": "How long to wait between concurrent readings. Only applicable to HP34420A"
                },
                "timeout": {
                    "type": "number",
                    "description": "How long to wait before throwing an error while waiting for data to come back."
                }
            }
        },
        "RF Source": {
            "description": "Possible RF source instrument settings.",
            "type": "object",
            "properties": {
                "f_GHz": {
                    "type": "number",
                    "description": "Frequency to set in GHz."
                },
                "AM": {
                    "type": "boolean",
                    "description": "Whether or not to use amplitude modulation."
                },
                "AM_ext_port": {
                    "type": "integer",
                    "description": "External port number to use for amplitude modulation."
                },
                "AM_ext_sensitivity_percent_per_volt": {
                    "type": "number",
                    "description": "Linear sensitivity (percent per volt) of the modulated signal to the DC input."
                }
            }
        },
        "Voltage Source": {
            "description": "Possible settings for a voltage source.",
            "type": "object",
            "properties": {
                "v_range": {
                    "type": "number",
                    "description": "Ouput voltage range."
                },
                "source_level": {
                    "type": "number",
                    "description": "Output voltage level."
                }
            }
        },
        "Commercial Power Meter": {
            "description": "Possible settings to use for a commercial power meter.",
            "type": "object",
            "properties": {
                "read_units": {
                    "type": "string",
                    "description": "Read units, restricted to Watts for compatibility.",
                    "enum": [
                        "W"
                    ]
                },
                "integration_time": {
                    "type": "number",
                    "description": "How long to integrate symbol in seconds.",
                    "minimum": 0,
                    "maximum": 0.3
                },
                "zero_once": {
                    "type": "boolean",
                    "description": "Forces a zeroing measurement to calibrate instrument, freezes the runner while it happens."
                },
                "timeout": {
                    "type": "number",
                    "description": "how long to wait (in seconds) for data to be available before throwing an error."
                },
                "average_state": {
                    "type": "str",
                    "description": "Activates continuous averaging of the sensor readings.",
                    "enum": [
                        "ON",
                        "OFF"
                    ]
                }
            }
        },
        "SMU": {
            "description": "Possible settings for a Source Measure Unit (SMU).",
            "type": "object",
            "properties": {
                "wiring": {
                    "type": "string",
                    "description": "What kind of wiring to use.",
                    "enum": [
                        "4W",
                        "2W"
                    ]
                },
                "source_measure": {
                    "type": "string",
                    "description": "What to source and measure (V or I)",
                    "enum": [
                        "SVMI",
                        "SVMV",
                        "SIMV",
                        "SIMI"
                    ]
                },
                "panel": {
                    "type": "string",
                    "description": "What to panel to use on the SMU",
                    "enum": [
                        "front",
                        "rear"
                    ]
                },
                "measure_for_duration_or_count": {
                    "type": "string",
                    "description": "Sets the K2450 to always measure for count. K2450 only.",
                    "enum": [
                        "count"
                    ]
                },
                "source_level": {
                    "type": "number",
                    "description": "Sets the source value in units of Volts or Amps (depending on source_measure setting)."
                },
                "source_on": {
                    "type": "string",
                    "description": "Sets the source output to on or off.",
                    "enum": [
                        "on",
                        "off"
                    ]
                },
                "source_range": {
                    "type": [
                        "string",
                        "number"
                    ],
                    "description": "'auto' or number, sets the source range."
                },
                "source_readback": {
                    "type": "boolean",
                    "description": "Sets the source to measure its output and report that value."
                },
                "measure_autozero": {
                    "type": "boolean",
                    "description": "Autozero the measurement values."
                },
                "source_delay": {
                    "type": ["string","number"],
                    "description": "'auto' or a number. Sets the delay between source adjustment and measurement read back."
                },
                "count_per_level": {
                    "type": ["number"],
                    "description": "Sets the number of readings per trigger. Typically 1."
                },
                "nplc": {
                    "type": ["number"],
                    "description": "Integration time in power line cycles."
                }
            }
        }
    }
}